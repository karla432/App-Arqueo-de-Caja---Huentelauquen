# Variables de entorno para PRODUCCIÓN. Copia este archivo FUERA del repositorio, complétalo y cárgalo en el servidor.
# NO guardes valores reales en archivos versionados (este archivo solo trae ejemplos vacíos).

ARQUEO_ENTORNO=produccion

# Clave secreta de la aplicación (larga y aleatoria; una distinta por servidor). Genera una con:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=

# Servidores por los que se accede, separados por coma (sin http://). Ej.: arqueo.midominio.cl
DJANGO_ALLOWED_HOSTS=

# Orígenes https de confianza (opcional), separados por coma. Ej.: https://arqueo.midominio.cl
DJANGO_CSRF_TRUSTED_ORIGINS=

# Ponlo en 1 solo si HTTPS termina en un proxy/balanceador que envía X-Forwarded-Proto.
DJANGO_PROXY_SSL=

# Ruta de la base de datos SQLite (opcional; por defecto db.sqlite3 junto al proyecto). Debe tener respaldo.
ARQUEO_DB_PATH=
